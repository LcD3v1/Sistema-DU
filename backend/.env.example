# ─────────────────────────────────────────────────────────────
#  FAST — North Police Department · Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores.
#  NUNCA versione o arquivo .env (ele está no .gitignore).
#  Em produção, configure cada variável no painel de
#  Environment Variables do seu provedor de hospedagem.
# ─────────────────────────────────────────────────────────────


# ── OBRIGATÓRIAS ──────────────────────────────────────────────

# String de conexão do MongoDB (Atlas → Connect → Drivers).
# Na primeira execução com o banco vazio, o backend/data.json antigo (se existir) é importado.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Nome do banco (padrão: fast)
MONGODB_DB=fast

# Segredo para assinar tokens JWT.
# NUNCA use o valor de exemplo em produção.
# Gere um novo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=mude-para-uma-string-aleatoria-forte-minimo-48-chars


# ── CONFIGURADAS AUTOMATICAMENTE PELA SHARDCLOUD ─────────────

# A ShardCloud injeta PORT automaticamente — não defina aqui.
# PORT=3001


# ── OPCIONAIS ─────────────────────────────────────────────────

# Arquivo data.json LEGADO — só é lido uma vez, para importar ao MongoDB vazio.
# Padrão: backend/data.json
# DATA_PATH=/data/swat-data.json
# DATA_PATH=

# Endereço público do site (usado na prévia do link no Discord/WhatsApp).
# Opcional: se vazio, é detectado pelo endereço acessado.
# PUBLIC_URL=https://meu-dominio.com

# CORS só tem efeito fora do NODE_ENV=production.
# Em produção o frontend roda no mesmo servidor, CORS é desligado.
# ALLOWED_ORIGIN=http://localhost:5173

# ── Login por Discord (OAuth2) — OBRIGATÓRIO ──────────────────
# O painel NÃO tem login por senha: todo acesso é via Discord.
# Crie um app em https://discord.com/developers/applications
# Em OAuth2 → Redirects, adicione a URL de callback abaixo.

# Seu ID do Discord (Modo desenvolvedor → clique direito no seu perfil → Copiar ID).
# No primeiro login, esse Discord assume a conta dona (acesso total).
# Aceita vários donos separados por vírgula: DISCORD_OWNER_ID=111...,222...
DISCORD_OWNER_ID=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback
FRONTEND_URL=http://localhost:5173

# Auto-cadastro no primeiro login via Discord (true/false). Novas contas entram
# sem cargo e aparecem em Configurações → Solicitações para aprovação.
DISCORD_AUTO_CREATE=true

# ── Bot do Discord (fóruns de Registro / Apreensões) — opcional ──
# 1. No mesmo app do Developer Portal, aba "Bot" → Reset Token e copie aqui.
#    Na mesma aba, ative "Server Members Intent" (necessário para detectar quem sai do servidor).
# 2. Convide o bot ao servidor com as permissões: Ver canais, Enviar mensagens,
#    Criar postagens públicas, Enviar mensagens em tópicos, Gerenciar tópicos, Inserir links.
# 3. DISCORD_GUILD_ID = ID do servidor (Modo desenvolvedor → clique direito no servidor → Copiar ID).
# Depois escolha os canais em Configurações → Canais no painel.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ── Segurança (opcionais — os padrões já são os mais seguros) ─────
# Firewall de aplicação: bane IPs abusivos (scanners, força bruta, assinaturas de ataque).
# FIREWALL_ATIVO=on
# Isenta 127.0.0.1/::1 (padrão: on fora de produção, off em produção).
# FIREWALL_ISENTAR_LOOPBACK=
# IPs privados (proxy sem X-Forwarded-For) nunca são banidos, só barrados por assinatura.
# FIREWALL_NAO_BANIR_PRIVADOS=on
# Pontos de abuso para banir, duração base (dobra ×4 a cada reincidência) e teto.
# FIREWALL_LIMIAR=100
# FIREWALL_BAN_MINUTOS=15
# FIREWALL_BAN_MAX_HORAS=24
# Máximo de IPs rastreados em memória.
# FIREWALL_MAX_IPS=20000

# Redireciona http→https quando o proxy envia X-Forwarded-Proto=http (só em produção).
# FORCAR_HTTPS=on

# JWT: exigir issuer/audience. Em produção é SEMPRE exigido.
# JWT_EXIGIR_EMISSOR=

# Logout persistente (coleção tokensRevogados no MongoDB). Use off só para depuração.
# REVOGACAO_PERSISTENTE=on

# Tamanho máximo do audit.log antes de rotacionar (MB).
# AUDIT_LOG_MAX_MB=20

# Chave para criptografar campos sensíveis em repouso (AES-256-GCM). 32 bytes.
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Diferente do JWT_SECRET. Se perdida, dados cifrados ficam ilegíveis — guarde com backup.
DATA_ENCRYPTION_KEY=
