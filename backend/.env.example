# ─────────────────────────────────────────────────────────────
#  FAST — North Police Department · Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores.
#  NUNCA versione o arquivo .env (ele está no .gitignore).
#  Em produção, configure cada variável no painel de
#  Environment Variables do seu provedor de hospedagem.
# ─────────────────────────────────────────────────────────────


# ── OBRIGATÓRIAS ──────────────────────────────────────────────

# Segredo para assinar tokens JWT.
# NUNCA use o valor de exemplo em produção.
# Gere um novo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=mude-para-uma-string-aleatoria-forte-minimo-48-chars


# ── CONFIGURADAS AUTOMATICAMENTE PELA SHARDCLOUD ─────────────

# A ShardCloud injeta PORT automaticamente — não defina aqui.
# PORT=3001


# ── OPCIONAIS ─────────────────────────────────────────────────

# Caminho absoluto para o arquivo data.json.
# Padrão: backend/data.json (junto ao executável compilado).
# Use um volume persistente na ShardCloud para não perder dados ao reiniciar:
# DATA_PATH=/data/swat-data.json
# DATA_PATH=

# CORS só tem efeito fora do NODE_ENV=production.
# Em produção o frontend roda no mesmo servidor, CORS é desligado.
# ALLOWED_ORIGIN=http://localhost:5173

# ── Login por Discord (OAuth2) — opcional ─────────────────────
# Crie um app em https://discord.com/developers/applications
# Em OAuth2 → Redirects, adicione a URL de callback abaixo.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback
FRONTEND_URL=http://localhost:5173

# Auto-cadastro de novos usuarios no primeiro login via Discord (true/false)
DISCORD_AUTO_CREATE=true
# Nivel atribuido a contas criadas via Discord (membro/moderador/admin/view_only)
DISCORD_DEFAULT_NIVEL=membro
